// The floating gauge: a slim, dark channel strip, like an audio plugin's meter, narrow
// enough to sit beside a code editor. Everything is drawn as vectors, so it stays sharp
// at any resolution (Full HD, 4K, Retina). Values below 0 mean "not known yet".

// Palette.
global Theme {
    out property <color> panel-top: #1e1f25;
    out property <color> panel-bottom: #121317;
    out property <color> plate: #17181d;
    out property <color> edge: #2d2f38;
    out property <color> text: #e9eaef;
    out property <color> muted: #8a8d99;
    out property <color> amber: #e3a23b;
    out property <color> red: #e2553f;
    out property <color> green: #47c08a;
    out property <color> unlit: #25262e;
}

// Small capital labels, as engraved on a front panel.
component Caption inherits Text {
    color: Theme.muted;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.8px;
    horizontal-alignment: center;
    // Room above capitals: Slint cuts a text at its own height (É, À).
    height: 12px;
    vertical-alignment: bottom;
}

// A recessed plate grouping one instrument.
component Plate inherits Rectangle {
    border-radius: 7px;
    background: Theme.plate;
    border-width: 1px;
    border-color: Theme.edge;
}

// A small knob: an amber arc over 270 degrees, the value inside, the caption below.
component Knob {
    in property <float> value;
    in property <string> caption;
    in property <string> shown;
    property <float> r: 22;
    property <angle> start: -135deg;
    property <angle> end: -135deg + 270deg * clamp(root.value, 0, 100) / 100;
    width: 60px;
    height: 74px;

    // Track, then value.
    Path {
        x: 0;
        y: 0;
        width: 60px;
        height: 60px;
        viewbox-width: 60;
        viewbox-height: 60;
        stroke: Theme.unlit;
        stroke-width: 4px;
        MoveTo {
            x: 30 + root.r * sin(root.start);
            y: 30 - root.r * cos(root.start);
        }
        ArcTo {
            x: 30 + root.r * sin(135deg);
            y: 30 - root.r * cos(135deg);
            radius-x: root.r;
            radius-y: root.r;
            sweep: true;
            large-arc: true;
        }
    }
    if root.value > 0.5: Path {
        x: 0;
        y: 0;
        width: 60px;
        height: 60px;
        viewbox-width: 60;
        viewbox-height: 60;
        stroke: Theme.amber;
        stroke-width: 4px;
        MoveTo {
            x: 30 + root.r * sin(root.start);
            y: 30 - root.r * cos(root.start);
        }
        ArcTo {
            x: 30 + root.r * sin(root.end);
            y: 30 - root.r * cos(root.end);
            radius-x: root.r;
            radius-y: root.r;
            sweep: true;
            large-arc: root.end - root.start > 180deg;
        }
    }
    // The cap, lit from above.
    Rectangle {
        x: 13px;
        y: 13px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: @radial-gradient(circle, #3a3c46 0%, #24252c 70%, #1b1c22 100%);
        border-width: 1px;
        border-color: #0d0e11;
        Text {
            text: root.shown;
            color: Theme.text;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Caption {
        x: 0;
        y: 60px;
        width: 60px;
        text: root.caption;
    }
}

export component GaugeWindow inherits Window {
    title: "Vario";
    no-frame: true;
    always-on-top: true;
    width: 156px;
    height: 494px;
    // A floating widget: only the rounded panel shows, the window itself is clear.
    background: transparent;

    in property <float> five-hour: -1;
    in property <string> five-hour-reset;
    in property <float> seven-day: -1;
    // 0 normal, 1 delegating more, 2 alert, 3 limit; -1 unknown.
    in property <int> level: -1;
    in property <float> delegated: -1;
    in property <float> escalated: -1;
    in property <string> updated;

    callback close-gauge();
    callback open-main();

    function percent(value: float) -> string {
        return value < 0 ? "—" : round(value) + " %";
    }

    // The needle meter's geometry: the pivot sits below the face, like a VU meter.
    property <float> cx: 66;
    property <float> cy: 104;
    property <float> scale-r: 76;
    property <angle> sweep-start: -50deg;
    property <angle> sweep: 100deg;
    property <angle> needle: root.sweep-start
        + root.sweep * clamp(max(root.five-hour, 0), 0, 100) / 100;

    // The panel, and a move area under everything: the gauge is dragged from anywhere
    // but its two buttons.
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 14px;
        background: @linear-gradient(180deg, Theme.panel-top 0%, Theme.panel-bottom 100%);
        border-width: 1px;
        border-color: Theme.edge;
    }
    WindowMoveArea {
        width: root.width;
        height: root.height;
    }

    // Header.
    Text {
        x: 12px;
        y: 9px;
        text: "Vario";
        color: Theme.amber;
        font-size: 17px;
        font-weight: 800;
        font-italic: true;
    }
    Rectangle {
        x: root.width - 26px;
        y: 10px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: close-area.has-hover ? Theme.red : #2a2b33;
        Text {
            text: "×";
            color: Theme.text;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-area := TouchArea {
            clicked => { root.close-gauge(); }
        }
    }

    // The needle meter, for the 5-hour quota.
    Plate {
        x: 12px;
        y: 36px;
        width: 132px;
        height: 112px;
        clip: true;
        // The face, with a soft light from its centre.
        Rectangle {
            x: 3px;
            y: 3px;
            width: 126px;
            height: 106px;
            border-radius: 5px;
            background: @radial-gradient(circle, #2c2d36 0%, #17181d 85%);
        }
        // Zones: neutral, amber from 50 %, red from 80 %.
        for band in [
            { from: 0, to: 50, color: #6f7280 },
            { from: 50, to: 80, color: #c58b30 },
            { from: 80, to: 100, color: #d24c38 },
        ]: Path {
            width: 132px;
            height: 112px;
            viewbox-width: 132;
            viewbox-height: 112;
            stroke: band.color;
            stroke-width: 3px;
            MoveTo {
                x: root.cx + root.scale-r * sin(root.sweep-start + root.sweep * band.from / 100);
                y: root.cy - root.scale-r * cos(root.sweep-start + root.sweep * band.from / 100);
            }
            ArcTo {
                x: root.cx + root.scale-r * sin(root.sweep-start + root.sweep * band.to / 100);
                y: root.cy - root.scale-r * cos(root.sweep-start + root.sweep * band.to / 100);
                radius-x: root.scale-r;
                radius-y: root.scale-r;
                sweep: true;
                large-arc: false;
            }
        }
        // Graduations every 10 %, longer every 50 %.
        for tick in 11: Path {
            property <angle> at: root.sweep-start + root.sweep * tick / 10;
            property <float> inner: mod(tick, 5) == 0 ? root.scale-r - 11 : root.scale-r - 7;
            width: 132px;
            height: 112px;
            viewbox-width: 132;
            viewbox-height: 112;
            stroke: tick >= 8 ? #d24c38 : #c9cbd4;
            stroke-width: mod(tick, 5) == 0 ? 1.6px : 1px;
            MoveTo {
                x: root.cx + parent.inner * sin(parent.at);
                y: root.cy - parent.inner * cos(parent.at);
            }
            LineTo {
                x: root.cx + (root.scale-r - 2) * sin(parent.at);
                y: root.cy - (root.scale-r - 2) * cos(parent.at);
            }
        }
        for mark in [0, 50, 100]: Text {
            property <angle> at: root.sweep-start + root.sweep * mark / 100;
            x: (root.cx + 52 * sin(self.at)) * 1px - self.width / 2;
            y: (root.cy - 52 * cos(self.at)) * 1px - self.height / 2;
            text: mark;
            color: #b9bbc6;
            font-size: 8px;
            font-weight: 700;
        }
        // The needle, with a red tip, turning around the pivot.
        Rectangle {
            x: root.cx * 1px - 1px;
            y: root.cy * 1px - 80px;
            width: 2px;
            height: 80px;
            background: #f1f2f6;
            transform-origin: { x: 1px, y: 80px };
            transform-rotation: root.needle;
            animate transform-rotation { duration: 700ms; easing: ease-out; }
            Rectangle {
                x: 0;
                y: 0;
                width: 2px;
                height: 14px;
                background: Theme.red;
            }
        }
        // The pivot's cover, and the glass's reflection.
        Rectangle {
            x: 0;
            y: 90px;
            width: 132px;
            height: 22px;
            background: @linear-gradient(180deg, #1d1e24 0%, #121317 100%);
            Caption {
                y: 4px;
                width: 132px;
                text: @tr("QUOTA 5 H");
            }
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 126px;
            height: 44px;
            border-radius: 5px;
            background: @linear-gradient(180deg, #ffffff14 0%, #ffffff00 100%);
        }
    }

    // The digital readout.
    Text {
        x: 0;
        y: 152px;
        width: root.width;
        text: root.percent(root.five-hour);
        color: root.five-hour >= 80 ? Theme.red : root.five-hour >= 50 ? Theme.amber : Theme.text;
        font-size: 24px;
        font-weight: 800;
        horizontal-alignment: center;
    }
    Text {
        x: 0;
        y: 184px;
        width: root.width;
        text: root.five-hour-reset;
        color: Theme.muted;
        font-size: 9px;
        horizontal-alignment: center;
    }

    // The 7-day quota, as a row of lit segments.
    Plate {
        x: 12px;
        y: 204px;
        width: 132px;
        height: 42px;
        Caption {
            x: 8px;
            y: 3px;
            text: @tr("7 DAYS");
            horizontal-alignment: left;
        }
        Text {
            x: 0;
            y: 3px;
            width: 124px;
            height: 12px;
            text: root.percent(root.seven-day);
            color: Theme.text;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: bottom;
        }
        for segment in 16: Rectangle {
            property <bool> lit: root.seven-day >= 0 && (segment + 0.5) * 100 / 16 <= root.seven-day;
            x: 8px + segment * 7.25px;
            y: 22px;
            width: 5.5px;
            height: 12px;
            border-radius: 1px;
            background: !self.lit ? Theme.unlit
                : segment >= 13 ? Theme.red
                : segment >= 8 ? Theme.amber
                : Theme.green;
        }
    }

    // The thermostat: one lamp per state, the active one lit.
    Plate {
        x: 12px;
        y: 254px;
        width: 132px;
        height: 84px;
        Caption {
            x: 8px;
            y: 3px;
            text: @tr("THERMOSTAT");
            horizontal-alignment: left;
        }
        for state[index] in [
            { label: @tr("Normal"), color: #47c08a },
            { label: @tr("Delegate more"), color: #e3a23b },
            { label: @tr("Alert"), color: #ec7d32 },
            { label: @tr("Limit"), color: #e2553f },
        ]: Rectangle {
            property <bool> lit: root.level == index;
            x: 10px;
            y: 20px + index * 15px;
            width: 114px;
            height: 13px;
            // The lamp, with a glow when lit.
            Rectangle {
                x: 0;
                y: 2px;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: parent.lit ? state.color : Theme.unlit;
                drop-shadow-blur: parent.lit ? 6px : 0;
                drop-shadow-color: state.color;
            }
            Text {
                x: 16px;
                width: 98px;
                height: 13px;
                text: state.label;
                color: parent.lit ? Theme.text : Theme.muted;
                font-size: 10px;
                font-weight: parent.lit ? 700 : 400;
                vertical-alignment: center;
            }
        }
    }

    // The knobs.
    Knob {
        x: 14px;
        y: 344px;
        value: max(root.delegated, 0);
        caption: @tr("DELEGATED");
        shown: root.percent(root.delegated);
    }
    Knob {
        x: 82px;
        y: 344px;
        value: max(root.escalated, 0);
        caption: @tr("ESCALATED");
        shown: root.percent(root.escalated);
    }

    // Footer: when the quota was seen; a click opens the main window.
    Rectangle {
        x: 12px;
        y: 428px;
        width: 132px;
        height: 22px;
        border-radius: 5px;
        background: open-area.has-hover ? #2a2b34 : #1b1c22;
        border-width: 1px;
        border-color: Theme.edge;
        Text {
            text: root.updated;
            color: Theme.muted;
            font-size: 9px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        open-area := TouchArea {
            clicked => { root.open-main(); }
        }
    }
    Text {
        x: 0;
        y: 456px;
        width: root.width;
        height: 14px;
        text: @tr("open Vario ↗");
        color: Theme.amber;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: bottom;
    }
    TouchArea {
        x: 0;
        y: 452px;
        width: root.width;
        height: 22px;
        clicked => { root.open-main(); }
    }
}
