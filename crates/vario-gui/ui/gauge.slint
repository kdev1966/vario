// The floating gauge: a slim, dark channel strip, like an audio plugin's meter, narrow
// enough to sit beside a code editor. Values below 0 mean "not known yet".

import { Theme, Caption, Plate, Panel, Logo, CloseButton, Lamp, Knob } from "theme.slint";

export component GaugeWindow inherits Window {
    title: "Vario";
    no-frame: true;
    always-on-top: true;
    width: 156px;
    height: 494px;
    // A floating widget: only the rounded panel shows, the window itself is clear.
    background: transparent;

    in property <float> five-hour: -1;
    in property <string> five-hour-reset;
    in property <float> seven-day: -1;
    // 0 normal, 1 delegating more, 2 alert, 3 limit; -1 unknown.
    in property <int> level: -1;
    in property <float> delegated: -1;
    in property <float> escalated: -1;
    in property <string> updated;
    // The quota was seen too long ago: the needle and the readout turn grey.
    in property <bool> stale;

    callback close-gauge();
    callback open-main();

    function percent(value: float) -> string {
        return value < 0 ? "—" : round(value) + " %";
    }

    // The needle meter's geometry: the pivot sits below the face, like a VU meter.
    property <float> cx: 66;
    property <float> cy: 104;
    property <float> scale-r: 76;
    property <angle> sweep-start: -50deg;
    property <angle> sweep: 100deg;
    property <angle> needle: root.sweep-start
        + root.sweep * clamp(max(root.five-hour, 0), 0, 100) / 100;

    // The panel, and a move area under everything: the gauge is dragged from anywhere
    // but its two buttons.
    Panel {
        width: root.width;
        height: root.height;
    }
    WindowMoveArea {
        width: root.width;
        height: root.height;
    }

    // Header.
    Logo {
        x: 12px;
        y: 9px;
    }
    CloseButton {
        x: root.width - 26px;
        y: 10px;
        clicked => { root.close-gauge(); }
    }

    // The needle meter, for the 5-hour quota.
    Plate {
        x: 12px;
        y: 36px;
        width: 132px;
        height: 112px;
        clip: true;
        // The face, with a soft light from its centre.
        Rectangle {
            x: 3px;
            y: 3px;
            width: 126px;
            height: 106px;
            border-radius: 5px;
            background: @radial-gradient(circle, #2c2d36 0%, #17181d 85%);
        }
        // Zones: neutral, amber from 50 %, red from 80 %.
        for band in [
            { from: 0, to: 50, color: #6f7280 },
            { from: 50, to: 80, color: #c58b30 },
            { from: 80, to: 100, color: #d24c38 },
        ]: Path {
            width: 132px;
            height: 112px;
            viewbox-width: 132;
            viewbox-height: 112;
            stroke: band.color;
            stroke-width: 3px;
            MoveTo {
                x: root.cx + root.scale-r * sin(root.sweep-start + root.sweep * band.from / 100);
                y: root.cy - root.scale-r * cos(root.sweep-start + root.sweep * band.from / 100);
            }
            ArcTo {
                x: root.cx + root.scale-r * sin(root.sweep-start + root.sweep * band.to / 100);
                y: root.cy - root.scale-r * cos(root.sweep-start + root.sweep * band.to / 100);
                radius-x: root.scale-r;
                radius-y: root.scale-r;
                sweep: true;
                large-arc: false;
            }
        }
        // Graduations every 10 %, longer every 50 %.
        for tick in 11: Path {
            property <angle> at: root.sweep-start + root.sweep * tick / 10;
            property <float> inner: mod(tick, 5) == 0 ? root.scale-r - 11 : root.scale-r - 7;
            width: 132px;
            height: 112px;
            viewbox-width: 132;
            viewbox-height: 112;
            stroke: tick >= 8 ? #d24c38 : #c9cbd4;
            stroke-width: mod(tick, 5) == 0 ? 1.6px : 1px;
            MoveTo {
                x: root.cx + parent.inner * sin(parent.at);
                y: root.cy - parent.inner * cos(parent.at);
            }
            LineTo {
                x: root.cx + (root.scale-r - 2) * sin(parent.at);
                y: root.cy - (root.scale-r - 2) * cos(parent.at);
            }
        }
        for mark in [0, 50, 100]: Text {
            property <angle> at: root.sweep-start + root.sweep * mark / 100;
            x: (root.cx + 52 * sin(self.at)) * 1px - self.width / 2;
            y: (root.cy - 52 * cos(self.at)) * 1px - self.height / 2;
            text: mark;
            color: #b9bbc6;
            font-size: 8px;
            font-weight: 700;
        }
        // The needle, with a red tip, turning around the pivot.
        Rectangle {
            x: root.cx * 1px - 1px;
            y: root.cy * 1px - 80px;
            width: 2px;
            height: 80px;
            background: root.stale ? Theme.muted : #f1f2f6;
            transform-origin: { x: 1px, y: 80px };
            transform-rotation: root.needle;
            animate transform-rotation { duration: 700ms; easing: ease-out; }
            Rectangle {
                x: 0;
                y: 0;
                width: 2px;
                height: 14px;
                background: root.stale ? Theme.muted : Theme.red;
            }
        }
        // The pivot's cover, and the glass's reflection.
        Rectangle {
            x: 0;
            y: 90px;
            width: 132px;
            height: 22px;
            background: @linear-gradient(180deg, #1d1e24 0%, #121317 100%);
            Caption {
                y: 4px;
                width: 132px;
                text: @tr("QUOTA 5 H");
            }
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 126px;
            height: 44px;
            border-radius: 5px;
            background: @linear-gradient(180deg, #ffffff14 0%, #ffffff00 100%);
        }
    }

    // The digital readout.
    Text {
        x: 0;
        y: 152px;
        width: root.width;
        text: root.percent(root.five-hour);
        color: root.stale ? Theme.muted : root.five-hour >= 80 ? Theme.red : root.five-hour >= 50 ? Theme.amber : Theme.text;
        font-size: 24px;
        font-weight: 800;
        horizontal-alignment: center;
    }
    Text {
        x: 0;
        y: 184px;
        width: root.width;
        text: root.five-hour-reset;
        color: Theme.muted;
        font-size: 9px;
        horizontal-alignment: center;
    }

    // The 7-day quota, as a row of lit segments.
    Plate {
        x: 12px;
        y: 204px;
        width: 132px;
        height: 42px;
        Caption {
            x: 8px;
            y: 3px;
            text: @tr("7 DAYS");
            horizontal-alignment: left;
        }
        Text {
            x: 0;
            y: 3px;
            width: 124px;
            height: 12px;
            text: root.percent(root.seven-day);
            color: Theme.text;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: bottom;
        }
        for segment in 16: Rectangle {
            property <bool> lit: root.seven-day >= 0 && (segment + 0.5) * 100 / 16 <= root.seven-day;
            x: 8px + segment * 7.25px;
            y: 22px;
            width: 5.5px;
            height: 12px;
            border-radius: 1px;
            background: !self.lit ? Theme.unlit
                : segment >= 13 ? Theme.red
                : segment >= 8 ? Theme.amber
                : Theme.green;
        }
    }

    // The thermostat: one lamp per state, the active one lit.
    Plate {
        x: 12px;
        y: 254px;
        width: 132px;
        height: 84px;
        Caption {
            x: 8px;
            y: 3px;
            text: @tr("THERMOSTAT");
            horizontal-alignment: left;
        }
        for state[index] in [
            { label: @tr("Normal"), color: #47c08a },
            { label: @tr("Delegate more"), color: #e3a23b },
            { label: @tr("Alert"), color: #ec7d32 },
            { label: @tr("Limit"), color: #e2553f },
        ]: Rectangle {
            property <bool> lit: root.level == index;
            x: 10px;
            y: 20px + index * 15px;
            width: 114px;
            height: 13px;
            Lamp {
                x: 0;
                y: 2px;
                lit: parent.lit;
                tint: state.color;
            }
            Text {
                x: 16px;
                width: 98px;
                height: 13px;
                text: state.label;
                color: parent.lit ? Theme.text : Theme.muted;
                font-size: 10px;
                font-weight: parent.lit ? 700 : 400;
                vertical-alignment: center;
            }
        }
    }

    // The knobs.
    Knob {
        x: 14px;
        y: 344px;
        value: max(root.delegated, 0);
        caption: @tr("DELEGATED");
        shown: root.percent(root.delegated);
    }
    Knob {
        x: 82px;
        y: 344px;
        value: max(root.escalated, 0);
        caption: @tr("ESCALATED");
        shown: root.percent(root.escalated);
    }

    // Footer: when the quota was seen; a click opens the main window.
    Rectangle {
        x: 12px;
        y: 428px;
        width: 132px;
        height: 22px;
        border-radius: 5px;
        background: open-area.has-hover ? #2a2b34 : #1b1c22;
        border-width: 1px;
        border-color: Theme.edge;
        Text {
            text: root.updated;
            color: root.stale ? Theme.amber : Theme.muted;
            font-size: root.stale ? 8px : 9px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        open-area := TouchArea {
            clicked => { root.open-main(); }
        }
    }
    Text {
        x: 0;
        y: 456px;
        width: root.width;
        height: 14px;
        text: @tr("open Vario ↗");
        color: Theme.amber;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: bottom;
    }
    TouchArea {
        x: 0;
        y: 452px;
        width: root.width;
        height: 22px;
        clicked => { root.open-main(); }
    }
}
