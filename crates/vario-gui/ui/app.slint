// Vario's main window: the same dark front panel as the gauge, wider, the height of
// the gauge so the two can sit side by side as one device. All logic lives in
// vario-core; this file only lays out what main.rs gives it. Texts are translated
// with @tr (lang/<language>/LC_MESSAGES), in the context of their component.

import { AboutSlint, ListView, Palette } from "std-widgets.slint";
import { Theme, Caption, Plate, Panel, Logo, CloseButton, Lamp, Key, Toggle, Knob } from "theme.slint";

export { GaugeWindow } from "gauge.slint";

// A state per kind of setup: 1 in place, 0 missing, -1 not offered by the client.
export struct ClientRow {
    label: string,
    subagents: int,
    instructions: int,
    hooks: int,
    quota: int,
    // 1 connected, 0 installed but not connected, -1 not installed.
    handoff: int,
    notes: string,
}

export struct Choice {
    label: string,
    selected: bool,
}

// One sub-agent, or the total; shares are -1 without delegations.
export struct ReportRow {
    agent: string,
    delegations: int,
    escalated: int,
    escalated-share: float,
    without-footer: int,
    without-footer-share: float,
}

// One lamp of a client card, with its caption.
component Indicator {
    in property <int> state;
    in property <string> caption;
    width: 64px;
    height: 26px;
    Lamp {
        x: (parent.width - self.width) / 2;
        y: 0;
        lit: root.state >= 0;
        tint: root.state > 0 ? Theme.green : Theme.red;
    }
    Caption {
        x: 0;
        y: 13px;
        width: parent.width;
        text: root.caption;
        color: root.state < 0 ? Theme.unlit.brighter(0.9) : Theme.muted;
    }
}

// One AI client: what Vario set up in it, and whether Handoff is connected.
component ClientCard inherits Plate {
    in property <ClientRow> client;
    height: 84px;
    Text {
        x: 10px;
        y: 8px;
        height: 16px;
        text: root.client.label;
        color: Theme.text;
        font-size: 12px;
        font-weight: 700;
    }
    Lamp {
        x: parent.width - 70px;
        y: 8px;
        lit: root.client.handoff >= 0;
        tint: root.client.handoff > 0 ? Theme.green : Theme.amber;
    }
    Caption {
        x: parent.width - 58px;
        y: 6px;
        width: 50px;
        horizontal-alignment: left;
        text: "HANDOFF";
        color: root.client.handoff < 0 ? Theme.unlit.brighter(0.9) : Theme.muted;
    }
    HorizontalLayout {
        x: 4px;
        y: 32px;
        height: 26px;
        alignment: start;
        Indicator { state: root.client.subagents; caption: @tr("AGENTS"); }
        Indicator { state: root.client.instructions; caption: @tr("GUIDANCE"); }
        Indicator { state: root.client.hooks; caption: @tr("HOOKS"); }
        Indicator { state: root.client.quota; caption: @tr("QUOTA"); }
    }
    Text {
        x: 10px;
        y: 62px;
        width: parent.width - 20px;
        height: 14px;
        text: root.client.notes;
        color: Theme.amber;
        font-size: 10px;
        overflow: elide;
    }
}

// A check box drawn as a small key, for the clients to install.
component Check {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled;
    callback toggled(bool);
    height: 22px;
    Rectangle {
        x: 0;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        background: Theme.key;
        border-width: 1px;
        border-color: root.checked && root.enabled ? Theme.amber : Theme.edge;
        Text {
            text: root.checked ? "✓" : "";
            color: root.enabled ? Theme.amber : Theme.muted;
            font-size: 11px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 24px;
        width: parent.width - 24px;
        text: root.text;
        color: root.enabled ? Theme.text : Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!root.checked); }
    }
}

// One channel of the delegations: the count, then escalations and missing footers.
component Channel inherits Plate {
    in property <ReportRow> entry;
    function percent(value: float) -> string {
        return value < 0 ? "—" : round(value) + " %";
    }
    height: 196px;
    Caption {
        x: 0;
        y: 8px;
        width: parent.width;
        text: root.entry.agent;
        color: Theme.amber;
        font-size: 9px;
    }
    Text {
        x: 0;
        y: 26px;
        width: parent.width;
        height: 34px;
        text: root.entry.delegations;
        color: Theme.text;
        font-size: 28px;
        font-weight: 800;
        horizontal-alignment: center;
    }
    Caption {
        x: 0;
        y: 62px;
        width: parent.width;
        text: @tr("DELEGATIONS");
    }
    Knob {
        x: parent.width / 2 - 66px;
        y: 88px;
        value: max(root.entry.escalated-share, 0);
        shown: root.percent(root.entry.escalated-share);
        caption: @tr("ESCALATED");
    }
    Knob {
        x: parent.width / 2 + 6px;
        y: 88px;
        value: max(root.entry.without-footer-share, 0);
        shown: root.percent(root.entry.without-footer-share);
        caption: @tr("NO FOOTER");
    }
    Text {
        x: parent.width / 2 - 66px;
        y: 166px;
        width: 60px;
        text: root.entry.escalated;
        color: Theme.muted;
        font-size: 10px;
        horizontal-alignment: center;
    }
    Text {
        x: parent.width / 2 + 6px;
        y: 166px;
        width: 60px;
        text: root.entry.without-footer;
        color: Theme.muted;
        font-size: 10px;
        horizontal-alignment: center;
    }
}

// A page key of the header; the open page is lit.
component PageKey {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: label.preferred-width + 18px;
    height: 24px;
    Rectangle {
        border-radius: 5px;
        background: root.active ? Theme.key : area.has-hover ? Theme.plate : transparent;
        border-width: root.active ? 1px : 0;
        border-color: Theme.edge;
    }
    label := Text {
        text: root.text;
        color: root.active ? Theme.amber : Theme.muted;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.8px;
        height: 14px;
        horizontal-alignment: center;
        vertical-alignment: bottom;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Vario";
    no-frame: true;
    width: 640px;
    height: 494px;
    // Only the rounded panel shows, as for the gauge.
    background: transparent;

    in property <string> version;
    // False just after the window appears: a click meant for the window that was
    // there must not press a key.
    in property <bool> ready: true;
    // The open page; main.rs may set it at start (VARIO_GUI_TAB, for screenshots).
    in-out property <int> current-tab;

    // Status
    in property <[ClientRow]> clients;
    in property <bool> needs-fix;
    in property <string> status-message;
    in property <string> handoff-hint;
    property <bool> confirm-remove;

    // Install
    in-out property <bool> manual;
    in property <[Choice]> choices;
    in property <[StandardListViewItem]> planned;
    in property <bool> can-apply;
    in property <string> install-message;
    in-out property <bool> gauge-with-sessions: true;

    // Delegations
    in property <[ReportRow]> report-rows;
    in property <string> report-period;
    in property <string> journal;

    callback refresh();
    callback open-gauge();
    callback close-main();
    callback repair();
    callback remove-all();
    callback mode-changed();
    callback toggle-choice(int, bool);
    callback preview();
    callback apply();
    callback gauge-setting-changed(bool);

    // The standard widgets used here (list, about box) follow the dark panel.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    Panel {
        width: root.width;
        height: root.height;
    }
    // Dragged from anywhere but its keys.
    WindowMoveArea {
        width: root.width;
        height: root.height;
    }

    // Header: the name, the pages, the close button.
    Logo {
        x: 12px;
        y: 9px;
    }
    HorizontalLayout {
        x: 84px;
        y: 8px;
        height: 24px;
        spacing: 4px;
        alignment: start;
        for page[index] in [@tr("STATUS"), @tr("INSTALL"), @tr("DELEGATIONS"), @tr("ABOUT")]: PageKey {
            text: page;
            active: root.current-tab == index;
            clicked => {
                root.confirm-remove = false;
                root.current-tab = index;
            }
        }
    }
    Key {
        x: root.width - 152px;
        y: 7px;
        width: 116px;
        text: @tr("Floating gauge");
        clicked => { root.open-gauge(); }
    }
    CloseButton {
        x: root.width - 26px;
        y: 12px;
        clicked => { root.close-main(); }
    }
    Rectangle {
        x: 12px;
        y: 40px;
        width: root.width - 24px;
        height: 1px;
        background: Theme.edge;
    }

    // Status: one card per client, a display for the message, and the keys.
    if root.current-tab == 0: Rectangle {
        // The display and the keys follow the cards, two per row.
        property <length> cards: ceil(root.clients.length / 2) * 92px;
        x: 12px;
        y: 50px;
        width: root.width - 24px;
        height: root.height - 62px;
        for row[index] in root.clients: ClientCard {
            x: mod(index, 2) * (parent.width + 8px) / 2;
            y: floor(index / 2) * 92px;
            width: (parent.width - 8px) / 2;
            client: row;
        }
        Plate {
            x: 0;
            y: parent.cards;
            width: parent.width;
            height: 84px;
            background: #101114;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.status-message;
                    color: root.needs-fix ? Theme.amber : Theme.green;
                    font-size: 12px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if root.handoff-hint != "": Text {
                    text: root.handoff-hint;
                    color: Theme.muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            x: 0;
            y: parent.cards + 96px;
            width: parent.width;
            height: 26px;
            spacing: 8px;
            alignment: start;
            Key {
                text: @tr("Refresh");
                clicked => { root.refresh(); }
            }
            Key {
                text: @tr("Repair");
                primary: root.needs-fix;
                enabled: root.needs-fix;
                clicked => { root.repair(); }
            }
            Key {
                text: @tr("Remove Vario…");
                clicked => { root.confirm-remove = true; }
            }
        }
        // Removing asks first, over the page.
        if root.confirm-remove: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #000000a0;
            border-radius: 7px;
            TouchArea {}
            Plate {
                x: (parent.width - self.width) / 2;
                y: 96px;
                width: 420px;
                height: 150px;
                background: Theme.panel-top;
                Text {
                    x: 16px;
                    y: 14px;
                    width: parent.width - 32px;
                    height: 18px;
                    text: @tr("Remove Vario from every client?");
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                }
                Text {
                    x: 16px;
                    y: 40px;
                    width: parent.width - 32px;
                    height: 54px;
                    text: @tr("Vario's sub-agents, instructions and hooks are removed; every file is backed up first, and a new install brings them back.");
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    x: 16px;
                    y: 108px;
                    height: 26px;
                    spacing: 8px;
                    alignment: start;
                    Key {
                        text: @tr("Remove");
                        primary: true;
                        clicked => {
                            root.confirm-remove = false;
                            root.remove-all();
                        }
                    }
                    Key {
                        text: @tr("Cancel");
                        clicked => { root.confirm-remove = false; }
                    }
                }
            }
        }
    }

    // Install: the clients and settings on the left, the planned changes on the right.
    if root.current-tab == 1: Rectangle {
        x: 12px;
        y: 50px;
        width: root.width - 24px;
        height: root.height - 62px;
        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: 30px;
            text: @tr("Vario adds economical sub-agents and delegation guidance to your AI clients. Nothing changes before you see the changes and apply them.");
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        Plate {
            x: 0;
            y: 40px;
            width: 236px;
            height: 330px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: start;
                Caption {
                    text: @tr("CLIENTS");
                    horizontal-alignment: left;
                }
                Toggle {
                    text: @tr("Manual mode: choose the clients one by one");
                    checked <=> root.manual;
                    toggled => { root.mode-changed(); }
                }
                if root.choices.length == 0: Text {
                    text: @tr("No supported AI client was found on this machine.");
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                for choice[index] in root.choices: Check {
                    text: choice.label;
                    checked: choice.selected;
                    enabled: root.manual;
                    toggled(checked) => { root.toggle-choice(index, checked); }
                }
                Rectangle { height: 6px; }
                Caption {
                    text: @tr("GAUGE");
                    horizontal-alignment: left;
                }
                Toggle {
                    text: @tr("Open the gauge with each agent");
                    checked <=> root.gauge-with-sessions;
                    toggled => { root.gauge-setting-changed(self.checked); }
                }
            }
        }
        Plate {
            x: 248px;
            y: 40px;
            width: parent.width - 248px;
            height: 330px;
            Caption {
                x: 12px;
                y: 8px;
                text: @tr("PLANNED CHANGES");
                horizontal-alignment: left;
            }
            if root.planned.length == 0: Text {
                x: 12px;
                y: 30px;
                width: parent.width - 24px;
                height: 40px;
                text: @tr("See the changes first: nothing is written before you apply them.");
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            ListView {
                x: 6px;
                y: 26px;
                width: parent.width - 12px;
                height: parent.height - 32px;
                for line in root.planned: Text {
                    height: 20px;
                    text: line.text;
                    color: Theme.text;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        HorizontalLayout {
            x: 0;
            y: 380px;
            width: parent.width;
            height: 26px;
            spacing: 8px;
            alignment: start;
            Key {
                text: @tr("See the changes");
                enabled: root.choices.length > 0;
                clicked => { root.preview(); }
            }
            Key {
                text: @tr("Apply");
                primary: true;
                enabled: root.can-apply;
                clicked => { root.apply(); }
            }
            Text {
                text: root.install-message;
                color: Theme.amber;
                font-size: 10px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // Delegations: one channel per sub-agent, and the total.
    if root.current-tab == 2: Rectangle {
        x: 12px;
        y: 50px;
        width: root.width - 24px;
        height: root.height - 62px;
        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: 30px;
            text: @tr("Each time one of Vario's sub-agents finishes, its report is noted locally. Escalations and missing report footers show where delegation falls short.");
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        Text {
            x: 0;
            y: 40px;
            width: parent.width;
            height: 18px;
            text: root.report-period;
            color: Theme.text;
            font-size: 12px;
            font-weight: 700;
        }
        for row[index] in root.report-rows: Channel {
            x: index * (parent.width + 12px) / 3;
            y: 68px;
            width: (parent.width - 24px) / 3;
            entry: row;
        }
        Text {
            x: 0;
            y: 280px;
            width: parent.width;
            height: 28px;
            text: root.journal;
            color: Theme.muted;
            font-size: 10px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            x: 0;
            y: 380px;
            width: parent.width;
            height: 26px;
            alignment: start;
            Key {
                text: @tr("Refresh");
                clicked => { root.refresh(); }
            }
        }
    }

    // About.
    if root.current-tab == 3: Rectangle {
        x: 12px;
        y: 50px;
        width: root.width - 24px;
        height: root.height - 62px;
        Logo {
            x: 4px;
            y: 6px;
            font-size: 40px;
        }
        Caption {
            x: 6px;
            y: 64px;
            text: @tr("VERSION {}", root.version);
            horizontal-alignment: left;
        }
        Text {
            x: 6px;
            y: 92px;
            width: 300px;
            height: 120px;
            text: @tr("Routes the simple tasks of your AI agents to cheaper models, through their own sub-agents. Local: Vario sends nothing to anyone. MIT licence.");
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
        }
        Plate {
            x: parent.width - 286px;
            y: 6px;
            width: 286px;
            height: 220px;
            AboutSlint {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
            }
        }
    }

    // Over everything while the window is not ready for clicks.
    if !root.ready: TouchArea {
        width: root.width;
        height: root.height;
    }
}
